API_PORT=4000
# CORS origin for browser callers on another origin. The storefront does not need it: it calls the
# API same-origin through the Next.js /api/v1 proxy (apps/web API_INTERNAL_URL).
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://primegear:primegear@localhost:5432/primegear?schema=public"
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
DEFAULT_STORE_SLUG=primegearbd

# Image storage: "local" (development, writes ./uploads and serves /uploads) or "r2" (required in production)
STORAGE_DRIVER=local
# local driver only (defaults shown)
# LOCAL_UPLOAD_DIR=./uploads
# LOCAL_PUBLIC_URL=/uploads
# LOCAL_UPLOAD_URL=/api/v1/uploads/local
# r2 driver: all required when STORAGE_DRIVER=r2. The bucket needs a CORS rule allowing PUT with
# Content-Type from the site origin (see README "Image uploads"); add the R2_PUBLIC_URL host to the
# web app's IMAGE_HOSTS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL or custom domain, e.g. https://media.primegearbd.com
R2_PUBLIC_URL=
