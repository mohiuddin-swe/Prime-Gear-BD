REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
DEFAULT_STORE_SLUG=primegearbd
