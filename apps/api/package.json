{
  "name": "@primegear/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "worker": "tsx watch --env-file-if-exists=.env src/workers/index.ts",
    "worker:start": "tsx --env-file-if-exists=.env src/workers/index.ts",
    "search:reindex": "tsx --env-file-if-exists=.env src/scripts/reindex-search.ts",
    "job:example": "tsx --env-file-if-exists=.env src/workers/enqueue-example.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@primegear/db": "workspace:*",
    "@primegear/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.6.7"
  }
}
