API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: ISO end time of the current flash sale (e.g. 2026-11-01T18:00:00+06:00). Strip is hidden when unset or past.
FLASH_SALE_ENDS_AT=
# Optional: extra next/image hosts, comma separated (e.g. R2 public domain)
IMAGE_HOSTS=
# Public API origin used by the browser for the cart (cookie-based, credentials: include)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: store WhatsApp number (01XXXXXXXXX). Shows the WhatsApp button in the header when set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: help-line number on the categories screen (01XXXXXXXXX). Defaults to the store line.
NEXT_PUBLIC_SUPPORT_PHONE=
