# Where the Next server reaches the API: server components call it directly, and the browser's
# same-origin /api/v1/* calls are proxied to it (next.config rewrites). Never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dev only: hosts other devices use to open the dev server, comma separated, wildcards allowed.
# Set to this computer's LAN IP to test on a phone on the same WiFi (e.g. 192.168.0.105 or 192.168.0.*).
DEV_ALLOWED_ORIGINS=
# Optional: ISO end time of the current flash sale (e.g. 2026-11-01T18:00:00+06:00). Strip is hidden when unset or past.
FLASH_SALE_ENDS_AT=
# Optional: extra next/image hosts, comma separated (e.g. R2 public domain)
IMAGE_HOSTS=
# Optional: store WhatsApp number (01XXXXXXXXX). Shows the WhatsApp button in the header when set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: help-line number on the categories screen (01XXXXXXXXX). Defaults to the store line.
NEXT_PUBLIC_SUPPORT_PHONE=
