{
  "name": "prime-gear-bd",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @primegear/db migrate",
    "db:seed": "pnpm --filter @primegear/db seed",
    "worker": "pnpm --filter @primegear/api worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
